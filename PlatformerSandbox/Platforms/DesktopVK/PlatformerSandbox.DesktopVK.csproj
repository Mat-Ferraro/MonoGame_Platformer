<Project Sdk="Microsoft.NET.Sdk">
  <!-- App name, identity and version come from ..\..\Resources\Identity.props. -->
  <Import Project="..\..\Resources\Identity.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    <DefineConstants>$(DefineConstants);GPU01_DESKTOPVK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>..\DesktopGL\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Resources\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\Resources\Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Source\**\*.cs" />
    <Compile Include="..\DesktopGL\Program.cs" Link="Program.cs" />
    <Compile Include="..\DesktopGL\Diagnostics\**\*.cs" Link="Diagnostics\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="..\..\Content\Assets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\PlatformerSandbox.Foundation\PlatformerSandbox.Foundation.csproj" />
    <ProjectReference Include="..\..\PlatformerSandbox.Gameplay\PlatformerSandbox.Gameplay.csproj" />
    <ProjectReference Include="..\..\PlatformerSandbox.Simulation\PlatformerSandbox.Simulation.csproj" />
    <ProjectReference Include="..\..\PlatformerSandbox.Diagnostics\PlatformerSandbox.Diagnostics.csproj" />
  </ItemGroup>
  <!-- Deploy animation art and its JSON manifest as readable assets. The
       PNG is decoded at runtime to avoid depending on an optional XNB build
       step for the test character. Keep these paths paired. -->
  <ItemGroup>
    <Content Include="..\..\Content\Assets\Characters\C02_TestCharacter.png"
             Link="Content\Characters\C02_TestCharacter.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Ship animation manifests as readable authoring data beside the PNG. -->
  <ItemGroup>
    <Content Include="..\..\Content\Characters\*.anim.json"
             Link="Content\Characters\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- A01 authored audio cues and original test samples. Kept as files rather
       than XNB until the sound content-builder workflow has been validated. -->
  <ItemGroup>
    <Content Include="..\..\Content\Audio\*.*"
             Link="Content\Audio\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- P02 editable particle playground presets. Runtime JSON, not XNB assets. -->
  <ItemGroup>
    <Content Include="..\..\Content\Particles\*.json"
             Link="Content\Particles\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- L01 phases 1-3: authored lighting lab scenes and optional material maps.
       These PNG/JSON files load directly; no MGCB/XNB shader step is required. -->
  <ItemGroup>
    <Content Include="..\..\Content\Lighting\**\*.*"
             Link="Content\Lighting\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\Content\BuildContent.targets" />
  <!-- Generates Info.plist for a hand-packaged macOS .app bundle, when building for macOS. -->
  <Import Project="..\..\Resources\macOS\MacBundle.targets" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
</Project>